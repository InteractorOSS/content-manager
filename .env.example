# Required - NextAuth
# The origin the CMS is actually served on. next-auth REWRITES every request's
# origin to this value (reqWithEnvURL), so a stale host here silently rewrites
# the OIDC redirect_uri and breaks SSO with no error at the authorize step.
NEXTAUTH_URL=https://cms.interactor.com
NEXTAUTH_SECRET=your-secret-here-run-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Interactor OAuth credentials (used for token refresh)
# Get these from the Interactor auth dashboard.
INTERACTOR_CLIENT_ID=your-client-id
INTERACTOR_CLIENT_SECRET=your-client-secret

# Interactor auth server
ACCOUNT_SERVER_URL=https://auth.interactor.com

# Interactor SSO (OIDC) — lets MFA accounts log in via auth.interactor.com's
# hosted login instead of the local email/password form, which can't do MFA.
# Same var names product-manager uses. The OAuth client must have
# https://cms.interactor.com/api/auth/callback/interactor (and
# http://localhost:4021/api/auth/callback/interactor for local dev)
# registered as a redirect_uri with Account Server. Leave unset to keep the
# CMS on credentials-only login (SSO button hidden). Both are REQUIRED in
# production — SSO is the only way into cms.interactor.com for MFA accounts.
# Check the whole chain with: npm run diagnose:sso
INTERACTOR_AUTH_CLIENT_ID=
INTERACTOR_AUTH_CLIENT_SECRET=

# CMS database (run: docker compose up -d)
DATABASE_URL="postgresql://postgres:postgres@localhost:5460/cms_dev"

# Media uploads — same S3 bucket the website uses. Leave the AWS keys
# unset in dev to fall back to local public/uploads storage. In production
# (NODE_ENV=production) there is no fallback: without the keys every upload
# is refused with a 503. Production gets them from the `production`
# environment's AWS_* secrets on each deploy (deploy-production.yml).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
S3_BUCKET=interactor-media
S3_PREFIX=www.interactor.com/images/
S3_PUBLIC_URL=https://interactor-media.s3.us-west-2.amazonaws.com/www.interactor.com/images/

# Seed bootstrap: grants super_admin to this email on `npx prisma db seed`
CMS_BOOTSTRAP_ADMIN_EMAIL=

# --- Social media publishing (Interactor Core) -------------------------------
# Core executes service actions (Facebook, Slack, ...) with per-user
# credentials collected through its hosted OAuth flow.
INTERACTOR_CORE_URL=https://core.interactor.com
# App-token client credentials for Core (an "application" created in the
# Interactor auth dashboard). Falls back to INTERACTOR_CLIENT_ID/SECRET.
INTERACTOR_API_CLIENT_ID=
INTERACTOR_API_CLIENT_SECRET=
# Signing secret from the POST /api/v1/webhooks registration. REQUIRED for
# /api/webhooks/interactor to accept anything: with this empty the receiver
# fails closed (503) in every environment, including dev, and social channel
# status stops syncing. See DEPLOYMENT.md § 1b.
INTERACTOR_WEBHOOK_SECRET=
# Optional bearer token so an external cron can POST /api/social/scheduler
CRON_SECRET=
# Set to "true" to disable the in-process 60s publish scheduler
SOCIAL_SCHEDULER_DISABLED=

# AI content generation (style analysis + drafting) — see CONTENT-AI-PLAN.md
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-4-8)
AI_MODEL=

# FAQ intake automation (CMS G#8) — a personal access token (/settings/tokens)
# for a user with content:create + content:edit, used by
# src/lib/faq-automation-client.ts to call POST/PATCH /api/automation/faq on
# this same app. Leave empty to leave intake/freshness off; both no-op until set.
FAQ_AUTOMATION_API_TOKEN=
# Optional: max new FAQ drafts the intake pipeline creates per day (default 20)
FAQ_INTAKE_MAX_DRAFTS_PER_DAY=

# User Knowledge-Base brand-voice push (Phase E, CONTENT-AI-PLAN.md §6/§8.6) —
# optional and UNVERIFIED (no platform-team coordination yet). Leave
# UKB_ORG_JWT empty to leave the feature off; it's a no-op until set.
UKB_URL=https://ukb.interactor.com
UKB_ORG_JWT=

# product-manager Ticket integration — bug reports from recognized CMS users
# create a real Ticket via product-manager's public intake API
# (POST /api/intake/{slug}/ticket). Requires a project there with the public
# portal enabled. Leave PRODUCT_MANAGER_PUBLIC_SLUG empty to leave the
# feature off; bug reports still save locally, just without a Ticket.
PRODUCT_MANAGER_URL=https://build.interactor.com
PRODUCT_MANAGER_PUBLIC_SLUG=
