// ---------------------------------------------------------------------------
// Social media management (Buffer/Hootsuite-style) — publishing goes through
// Interactor Core (core.interactor.com): channels wrap Interactor credentials,
// posts are executed via /api/v1/execute service actions.
// ---------------------------------------------------------------------------

model SocialChannel {
  id               String             @id @default(cuid())
  organization_id  String
  organization     Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  service_id       String // SKB service slug, e.g. "facebook-graph-api", "slack" — freeform for delivery_mode "manual" (no SKB adapter required)
  service_name     String // display name, e.g. "Facebook Page"
  // G#27: "automated" publishes through Interactor Core /execute (the
  // existing flow); "manual" means no API access exists for this channel at
  // all — e.g. a personal Facebook profile, which Meta's Graph API only lets
  // you post to via a Page, never on a person's behalf. A manual channel has
  // no credential_id/OAuth flow; a human pastes the copy on the real platform
  // themselves from the awaiting_manual queue (src/lib/social/manual.ts) and
  // records the permalink back via mark_social_post_posted. General on
  // purpose — any service_id can be manual, not just Facebook.
  delivery_mode    String             @default("automated") // automated | manual
  // One OAuth connection can post to several places — three Facebook Pages,
  // five Slack channels, two subreddits. Each place is its own row (a
  // "destination"), and the rows of one connection share credential_id and
  // external_user_id. That is why credential_id is indexed but NOT unique: it
  // was unique when a connection could only ever mean one account.
  credential_id    String? // Interactor credential id backing this channel
  external_user_id String // Interactor external_user_id the credential is scoped to
  account_name     String? // page name / handle / workspace
  account_id       String? // provider-side id (e.g. Facebook page-id, Slack channel)
  // Whether a post's social copy goes here unless the writer says otherwise
  // for that post (Post.social_destinations).
  default_target   Boolean            @default(true)
  avatar_url       String?
  status           String             @default("pending") // pending | active | expired | revoked | error
  connected_by_id  String?
  connected_by     User?              @relation("ChannelConnector", fields: [connected_by_id], references: [id])
  metadata         Json?
  inserted_at      DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  targets          SocialPostTarget[]

  @@index([credential_id])
  @@index([organization_id, external_user_id])
  @@map("social_channels")
}

// ---------------------------------------------------------------------------
// Two-way git content sync (FILE-BASED-CONTENT-PLAN.md Phase 2) — same
// pattern as SocialChannel: wraps an Interactor credential (hosted OAuth to
// GitHub via the SKB), writes execute through /api/v1/execute. One active
// connection per deployment for now (org-scoped multi-connection is a
// follow-up once the Organization model lands).
// ---------------------------------------------------------------------------

model ContentSyncConnection {
  id               String   @id @default(cuid())
  service_id       String   @default("github") // SKB service slug
  credential_id    String?  @unique // Interactor credential id backing this connection
  external_user_id String // Interactor external_user_id the credential is scoped to
  repo             String // "owner/repo"
  branch           String   @default("main")
  status           String   @default("pending") // pending | active | expired | revoked | error
  connected_by_id  String?
  connected_by     User?    @relation("ContentSyncConnector", fields: [connected_by_id], references: [id])
  metadata         Json?
  inserted_at      DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("content_sync_connections")
}

model SocialCampaign {
  id              String       @id @default(cuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  name            String
  color           String?
  description     String?
  recycle         Boolean      @default(false) // evergreen recycling (SocialBee-style)
  posts           SocialPost[]
  inserted_at     DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organization_id, name])
  @@map("social_campaigns")
}

model SocialPost {
  id               String               @id @default(cuid())
  organization_id  String
  organization     Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  body             String               @default("")
  link             String?
  media            Json? // [{ media_id, url, type, alt }] — every item is a Media row in this org (src/lib/social/media.ts)
  // What follows `body` (the root post), in order: `[{ kind: "thread" |
  // "first_comment", body }]` — the X replies of a thread, then at most one
  // first comment (src/lib/social/parts.ts). NULL = never set; copy written
  // for X before this column existed is read through its `---` lines instead.
  parts            Json?
  status           String               @default("draft") // draft | pending_review | approved | rejected | scheduled | publishing | awaiting_manual | published | partially_published | failed | archived
  rejection_reason String?
  // AI fan-out provenance (CONTENT-AI-PLAN.md §6 / decision #4): the blog Post
  // this copy was generated from, and the network the copy was written for
  // (linkedin | twitter | facebook). Both null for hand-written posts.
  source_post_id   String?
  source_post      Post?                @relation("SocialPostSource", fields: [source_post_id], references: [id], onDelete: SetNull)
  network          String?
  scheduled_at     DateTime?
  published_at     DateTime?
  campaign_id      String?
  campaign         SocialCampaign?      @relation(fields: [campaign_id], references: [id])
  created_by_id    String?
  created_by       User?                @relation("SocialPostAuthor", fields: [created_by_id], references: [id])
  approved_by_id   String?
  approved_by      User?                @relation("SocialPostApprover", fields: [approved_by_id], references: [id])
  approved_at      DateTime?
  targets          SocialPostTarget[]
  approvals        SocialPostApproval[]
  inserted_at      DateTime             @default(now())
  updated_at       DateTime             @updatedAt

  @@index([status, scheduled_at])
  @@index([organization_id, status, scheduled_at])
  @@map("social_posts")
}

model SocialPostTarget {
  id               String        @id @default(cuid())
  post_id          String
  post             SocialPost    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  channel_id       String
  channel          SocialChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  body_override    String? // per-network copy customization
  // Per-channel media that replaces the post's `media` for this target only
  // (punchlist S1), same item shape. NULL = publish the post's media; an
  // empty array = no media on this channel.
  media_override   Json?
  status           String        @default("pending") // pending | publishing | awaiting_manual | published | failed | skipped
  external_post_id String?
  external_url     String?
  error            String?
  attempt_count    Int           @default(0)
  // The earliest moment the scheduler may act on this row again. Meaning
  // follows `status`: on a "pending" target it is when the next publish
  // attempt is due (Core's own Retry-After when it sent one, otherwise our
  // backoff); on a "publishing" target it is when the in-flight attempt's
  // lease expires and the stale sweep may hand the row back to "pending".
  // Null on a terminal row, and on every row written before this column
  // existed. The scheduler reads null as "due now" on a "pending" target; on a
  // "publishing" one it has no lease to read, so the stale sweep dates that
  // row's lease from `updated_at` instead — which is how a target the old code
  // stranded mid-flight still gets handed back.
  //
  // Deliberately its own column rather than `updated_at + f(attempt_count)`:
  // updated_at moves for any unrelated write to the row, and only an explicit
  // column can hold a delay Core supplied rather than one we guessed.
  next_attempt_at  DateTime?
  // Media this target has already uploaded to the network, so a retry (or an
  // attempt resumed after a crash inside the publish lease) reuses them rather
  // than uploading every image again: `{ "<network>:<step>:<account>:<media>":
  // { "id": "<provider id>", "at": "<ISO time>" } }`. Written as each upload
  // lands, reused while younger than the publisher's reuse window, cleared
  // once the target publishes. NULL = nothing uploaded yet.
  media_uploads    Json?
  // Each part of the post this target has already published, by its place
  // in the publish plan (0 = the root post, then each reply, then the first
  // comment): `[{ kind, id, url?, at }]`. Written the moment a part lands, so
  // a retry resumes after the last one instead of posting the root again.
  // Kept after publishing as the record of where each part went.
  published_parts  Json?
  published_at     DateTime?
  inserted_at      DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@unique([post_id, channel_id])
  @@map("social_post_targets")
}

model SocialPostApproval {
  id          String     @id @default(cuid())
  post_id     String
  post        SocialPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  reviewer_id String?
  reviewer    User?      @relation("SocialApprovalReviewer", fields: [reviewer_id], references: [id])
  action      String // approved | rejected | requested_changes
  comments    String?
  reviewed_at DateTime   @default(now())
  inserted_at DateTime   @default(now())

