  diff_summary    String // human-readable summary of what the author changed
  rationale       String // why this points to a durable style preference
  suggested_guide String // full proposed next-version guide text (markdown)
  status          String       @default("pending") // pending | accepted | rejected
  inserted_at     DateTime     @default(now())
  resolved_at     DateTime?

  @@index([profile_id, status])
  @@map("guide_amendment_suggestions")
}

// Feedback + bug reports from both CMS users and public website visitors.
// source is authoritative server-side (never trusted from the client): a
// submission counts as cms_user if the submitter is logged in, or (for
// anonymous submissions) their given email matches an existing CMS user —
// everyone else is website_visitor. Only bug_report + cms_user submissions
// attempt to create a real Ticket in product-manager (see src/lib/product-manager.ts);
// ticket_number/ticket_url/ticket_error are best-effort and never block
// creation of this row.
model Feedback {
  id              String       @id @default(cuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  type            String       @default("feedback") // feedback | bug_report
  source          String // cms_user | website_visitor
  status          String       @default("open") // open | acknowledged | closed
  title           String
  body            String?
  author_name     String?
  author_email    String?
  submitted_by_id String?
  submitted_by    User?        @relation("FeedbackSubmitter", fields: [submitted_by_id], references: [id], onDelete: SetNull)
  page_url        String?
  user_agent      String?
  screenshot_url  String?
  metadata        Json?
  ticket_number   Int?
  ticket_url      String?
  ticket_error    String?
  inserted_at     DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@index([status])
  @@index([submitted_by_id])
  @@map("feedback_entries")
}
