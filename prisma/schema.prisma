// Continuous learning (Phase D, CONTENT-AI-PLAN.md §4 point 5): proposed the
// moment a post with AI provenance is approved/published and its content
// differs from the AI-generated baseline. Never applied automatically —
// accepting one creates a new StyleGuideVersion (created_by: "edit-learning").
model GuideAmendmentSuggestion {
  id              String       @id @default(cuid())
  profile_id      String
  profile         StyleProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  post_id         String?
