// The org's content-type registry (G#19) — what the editor offers in its type
// control, so a new content type is a row here rather than a new Prisma model,
// a new API surface, and a new pair of MCP tools.
//
// Deliberately NOT referenced by a FK from Post.type. The registry exists for
// discoverability (what can I pick?), not enforcement: a `.md` file or an MCP
// client may carry a type this org hasn't registered, and dropping that import
// on the floor would recreate the closed-enum failure this replaces. Unknown
// types render as themselves and can be adopted into the registry after the fact.
model ContentType {
  id              String       @id @default(cuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  // Matches Post.type — lowercase kebab token (contentTypeSchema).
  slug            String
  name            String
  description     String?
  sort_order      Int          @default(0)
  inserted_at     DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organization_id, slug])
  @@unique([organization_id, name])
  @@map("content_types")
}

// A distribution target — one consuming site that can surface a post (G#18).
// Replaces the hardcoded allowlist that used to live in src/lib/platforms.ts,
// so an org can add its own site without a deploy.
//
// Deliberately mirrors ContentType above: same org-scoped registry shape, and
// the same DISCOVERABILITY-not-enforcement contract. `Post.platforms` stays a
// `String[]` of slugs with no FK to these rows — that array is what keeps a
// post targetable at SEVERAL sites at once, which a join to a single Site row
// could not express, and it is what the public `?platform=` filter matches on.
// Because nothing here is a foreign key, the built-in slugs need no seed rows
// and no backfill: BUILT_IN_SITES in src/lib/sites.ts supplies them virtually
// and mergeSites() folds in any slug already in use, so no existing post can
// change visibility when this lands.
model Site {
  id              String       @id @default(cuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  // Matches a Post.platforms entry — lowercase kebab token (siteSlugSchema).
  slug            String
  name            String
  description     String?
  // The site's base URL (e.g. https://example.com), used to build the
  // per-site RSS feed and sitemap: <link>/<loc> = `${url}/${post.slug}`.
  // NOT NULL — a site with nothing to link to isn't meaningfully
  // registered. See migration 20260912180000_add_site_url for how existing
  // rows were backfilled.
  url             String
  sort_order      Int          @default(0)
  // Resolved `seo` block publisher identity (G#33, SEO-AEO-GEO-PLAN.md Layer
  // C): the Organization schema.org node the site's posts are published
  // under. `publisher_name` falls back to `name`; `logo_url` falls back to
  // the org's `logo`. Per-site rather than per-org because one org's blog and
  // its partner-embedded copy can legitimately want different bylines.
  publisher_name  String?
  logo_url        String?
  // IndexNow verification key (G#34, SEO-AEO-GEO-PLAN.md Layer D): Bing's
  // IndexNow protocol requires the consuming site to host this exact string
  // at `${url}/<key>.txt` before a ping naming that key is trusted — the CMS
  // cannot host that file itself (it lives on the SITE's own domain), so the
  // key only round-trips through the public API for the consuming site's own
  // route to read and serve verbatim. Auto-generated on site creation and
  // lazily backfilled the first time the public endpoint is read for a site
  // that predates this column, so an org never has to notice this exists to
  // get a working key — see src/lib/indexnow.ts.
  indexnow_key    String?
  inserted_at     DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organization_id, slug])
  @@unique([organization_id, name])
  @@map("sites")
}

